# Copy to .env locally. Never commit credentials.
WEB_APP_URL=http://localhost:5181
# Single origin for email links and Clerk invitations; falls back to first WEB_APP_URL.
FRONTEND_URL=http://localhost:5181
API_HOSTS=localhost,127.0.0.1
PAYMENT_PROVIDER=simulated
PGHOST=/tmp
PGPORT=5432
# Local concurrency specs require >=13 connections; Render uses 3 threads.
RAILS_MAX_THREADS=20
EMAIL_DELIVERY_ENABLED=false

# Production: Neon pooled URL for requests; direct URL for release migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/tano_y_tasi_production?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/tano_y_tasi_production?sslmode=require
# EXPECTED_DATABASE_NAME=tano_y_tasi_production
# SECRET_KEY_BASE=
# WEB_APP_URL=https://tanoytasi.shimizu-technology.com
# FRONTEND_URL=https://tanoytasi.shimizu-technology.com
# API_HOSTS=tano-y-tasi-api.onrender.com
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FORCE_SSL=true
# ASSUME_SSL=true
# RAILS_MAX_THREADS=3

# Clerk: required for admin access. Missing config returns 503; storefront still boots.
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTIES=https://tanoytasi.shimizu-technology.com
# CLERK_JWKS_URL= # optional HTTPS override; default: derived issuer/.well-known/jwks.json
# ADMIN_EMAILS= # comma-separated verified primary emails allowed to bootstrap
# ADMIN_NOTIFICATION_EMAILS= # optional override; absent means all active admin emails

# Resend: enable only after the from-address domain is verified.
# RESEND_API_KEY=
# MAILER_FROM_EMAIL="Tåno + Tåsi <orders@shimizu-technology.com>"
# EMAIL_DELIVERY_ENABLED=true

# S3: product image uploads. Missing values return 503 on upload; the API still boots.
# The bucket's public URLs must stay readable under products/, and the IAM user only needs PutObject there.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=tano-y-tasi-media

# EasyPost: live shipping rates, labels and tracking. Optional: without a key, checkout uses flat rates.
# The webhook endpoint is POST /api/v1/webhooks/easypost; give EasyPost this same secret when creating it.
# Use a test key here. A production key buys real postage.
# EASYPOST_API_KEY=
# EASYPOST_WEBHOOK_SECRET=
