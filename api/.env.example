# Copy to .env locally. Never commit keys.
WEB_APP_URL=http://localhost:5181
API_HOSTS=localhost,127.0.0.1
PAYMENT_PROVIDER=simulated
PGHOST=/tmp
PGPORT=5432
RAILS_MAX_THREADS=20
# Stripe requires both when PAYMENT_PROVIDER=stripe:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CI example (test only): postgres://postgres:postgres@localhost:5432/tano_y_tasi_test
# DATABASE_URL=
# Production: PAYMENT_PROVIDER=stripe, HTTPS WEB_APP_URL, API_HOSTS,
# DATABASE_URL, SECRET_KEY_BASE, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
FORCE_SSL=true
ASSUME_SSL=true
